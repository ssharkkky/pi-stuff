{
  "theme": "claude-code-light/claude-code-dark",
  "quietStartup": true,
  "packages": [
    "git:github.com/ssharkkky/pi-stuff",
    "npm:better-claude-code-ui",
    "npm:better-custom-provider",
    "npm:@monotykamary/pi-tps",
    "npm:@narumitw/pi-goal",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents"
  ],
  "steeringMode": "one-at-a-time",
  "tuiMode": "fullscreen",
  "compaction": {
    "enabled": true
  },
  "hideThinkingBlock": true,
  "showCacheMissNotices": true,
  "terminal": {
    "showTerminalProgress": false
  },
  "collapseChangelog": true,
  "doubleEscapeAction": "tree",
  "modelThinkingLevels": {
    "llama-local/Qwen3.8-27B-Heretic-Uncensored": "max"
  },
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  }
}
